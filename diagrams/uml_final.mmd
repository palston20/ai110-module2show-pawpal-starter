classDiagram
    %% PawPal+ class design. Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() list~tuple~Pet, Task~~
        +get_owner_info() str
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_pending_tasks() list~Task~
        +get_completed_tasks() list~Task~
        +get_pet_info() str
    }

    class Task {
        +str description
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +date due_date
        +priority_rank() int
        +mark_complete() None
        +mark_incomplete() None
        +next_occurrence() Task
        +edit(description, duration_minutes, priority, time, frequency) None
    }

    class Scheduler {
        +Owner owner
        +list~tuple~Pet, Task~~ plan
        +list~tuple~Pet, Task~~ skipped
        +list~str~ conflicts
        +get_all_tasks(include_completed: bool) list~tuple~Pet, Task~~
        +filter_by_status(completed: bool) list~tuple~Pet, Task~~
        +enter_task(pet: Pet, task: Task) None
        +mark_task_complete(task: Task) Task
        +get_tasks_due(day: date) list~tuple~Pet, Task~~
        +detect_conflicts(pairs) list~str~
        +edit_task(task: Task, **changes) None
        +sort_by_priority(pairs) list~tuple~Pet, Task~~
        +sort_by_time(pairs) list~tuple~Pet, Task~~
        +generate_plan(day: date) list~tuple~Pet, Task~~
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : needs
    Scheduler --> Owner : gets tasks through
